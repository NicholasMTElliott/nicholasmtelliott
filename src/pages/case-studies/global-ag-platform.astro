---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { syngentaArchitectureAreas, technologyEvidence } from '../../data/portfolio'
import caseFilm from '../../data/case-film.json'

const outcomes = [
  'E-Luminate / GHX Fields: a few hundred advisors serving 10,000+ growers across the US and Canada.',
  'Cropwise: similar scale in international markets including Argentina, Brazil, Germany, Ukraine, and Hungary.',
  'Azure-to-AWS migration: 20 systems in six months, 25% lower burn rate, 75% faster deployments.',
  'Enterprise integrations with Salesforce, SAP, and a sales-hierarchy abstraction reused across regions.',
  'SOC 2 Type 2 passed in 2025, built on observability and processes the team already ran.',
  'Root Cause shipped to production in 2026: 90,000 fields analyzed weekly, reaching 90% of growers.',
]

const roleSignals = [
  'Led architecture and the engineering organization behind the platforms for fifteen years, 2011 through 2026.',
  'Owned architecture and modernization strategy across cloud, services, integrations, data, and UI.',
  'Led a US-distributed engineering team and owned the finished product, integrating work from partner teams in India, Brazil, Egypt, and Europe.',
  'Mentored and planned the handoff so Syngenta’s internal teams could own the platforms outright.',
]

// The film's text version (it has no narration yet), in the film's order. Keep it in step with video/src/story-case.js.
const filmText = [
  {
    label: '2011',
    text: 'E‑Luminate starts as a sustainability app in crop protection, with a seed catalog.',
    mine: 'I led the platform’s architecture and engineering org.',
  },
  {
    label: '2017',
    text: 'The seed catalog becomes North America’s seed recommendation and ordering platform, with Game Plan for whole-farm planning across brands.',
  },
  {
    label: '2020',
    text: 'We take it global as Cropwise Seed Selector: Brazil, Argentina, the UK, Germany, Hungary, Ukraine, and more. Cropwise Planting follows as a South America pilot.',
    mine: 'I owned the finished product.',
  },
  {
    label: 'Shared layer',
    text: 'Every region structures its sales network differently. One sales-hierarchy model serves all of them, across every app.',
    mine: 'I designed the abstraction.',
  },
  {
    label: 'Field health',
    text: 'Weather, disease models, satellite imagery, scouting, and field activity become health and yield potential for every field, delivered as PDF reports by email. E‑Luminate is now GHX Fields.',
    mine: 'I designed it and wrote much of the code.',
  },
  {
    label: '2026',
    text: 'Root Cause puts AI into production: it reads 90,000 fields a week and flags risks and fixes to advisors, reps, and growers before anyone asks.',
    mine: 'I led it into production.',
  },
  {
    label: 'Foundation',
    text: 'AWS with CDK, Fargate, and Lambda; Temporal, RabbitMQ, and Redis; Prometheus, Loki, Tempo, and Grafana. Twenty systems moved to AWS in six months.',
    mine: 'I led the AWS migration and observability.',
  },
]
---

<BaseLayout
  title="Nicholas M. T. Elliott | Global Agricultural Platform Case Study"
  description="Case study on enterprise platform delivery, distributed engineering leadership, AWS modernization, observability, integrations, and production AI for Syngenta-scale agricultural systems."
  ogType="article"
  preloadImage="/images/generated/ag-platform-architecture.webp"
>
  <article class="case-study">
    <header class="case-hero">
      <div>
        <p class="eyebrow">Case study · Syngenta, 2011–2026</p>
        <h1>Global Agricultural Recommendation Platform</h1>
        <p>
          Fifteen years building E-Luminate, GHX Fields, and Cropwise for Syngenta: from a regional sustainability
          tool to seed-recommendation systems that a few hundred advisors use to serve 10,000+ growers per platform,
          across North America, South America, and Europe. Some details stay at category level out of respect for
          Syngenta's confidentiality.
        </p>
        <div class="button-row">
          <a class="button" href="/contact/leadership/">Tell me about the role</a>
          <a class="button-secondary" href="/ai">See the AI layer</a>
        </div>
      </div>
      <aside class="case-summary card">
        <p class="eyebrow">Scope at a glance</p>
        <dl>
          <div><dt>Program</dt><dd>Syngenta · global agribusiness · 2011–2026</dd></div>
          <div><dt>Reach</dt><dd>10,000+ growers per platform, across three continents</dd></div>
          <div><dt>Systems</dt><dd>Web apps, APIs, AWS, Salesforce/SAP integrations, observability, AI</dd></div>
          <div><dt>My role</dt><dd>Architect, engineering org lead, delivery owner, mentor</dd></div>
        </dl>
      </aside>
    </header>

    <section class="section case-film" aria-labelledby="case-film-title">
      <div class="section-heading">
        <p class="eyebrow">Film · {Math.round(caseFilm.durationSec)} seconds</p>
        <h2 id="case-film-title">The platform, assembled</h2>
      </div>
      <div class="case-film__grid">
        <figure class="case-film__frame card">
          <video
            controls
            preload="metadata"
            playsinline
            width="1080"
            height="1080"
            poster={caseFilm.poster}
            aria-labelledby="case-film-title"
            aria-describedby="case-film-text"
          >
            <source src={caseFilm.src} type="video/mp4" />
            <a href={caseFilm.src}>Download the film (MP4, {caseFilm.sizeMB} MB)</a>
          </video>
        </figure>
        <ol class="case-film__text" id="case-film-text">
          {
            filmText.map(item => (
              <li>
                <strong>{item.label}</strong>
                <p>{item.text}</p>
                {item.mine && <p class="case-film__mine">{item.mine}</p>}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">The problem</p>
        <h2>Every region farms differently</h2>
        <p>
          A seed recommendation depends on agronomic data, weather, product catalogs, territory rules, discounts, and
          sales hierarchies — and every one of those works differently in Iowa, Mato Grosso, and Hungary. Building a
          separate app per market would have buried the team in duplicate work. The durable value was a set of
          platform abstractions that absorbed regional differences instead of multiplying them.
        </p>
      </div>
    </section>

    <section class="section architecture">
      <div class="section-heading">
        <p class="eyebrow">Architecture</p>
        <h2>The shape of the platform</h2>
      </div>
      <div class="architecture-grid">
        {
          syngentaArchitectureAreas.map(area => (
            <article class="architecture-card card">
              <h3>{area.title}</h3>
              <p>{area.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section role-impact">
      <div class="section-heading">
        <p class="eyebrow">My role</p>
        <h2>What I was accountable for</h2>
      </div>
      <div class="role-grid">
        {
          roleSignals.map(signal => (
            <article class="card">
              <p>{signal}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Outcomes</p>
        <h2>What the numbers say</h2>
      </div>
      <ul class="outcome-list">
        {outcomes.map(outcome => <li>{outcome}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Technology</p>
        <h2>The stack, with receipts</h2>
      </div>
      <div class="tech-grid">
        {
          technologyEvidence.filter(item => item.scope === 'syngenta').map(item => (
            <article class="card">
              <h3>{item.area}</h3>
              <p class="tools">{item.tools}</p>
              <p>{item.proof}</p>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>

<style lang="scss">
  .case-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .case-hero > div {
    min-height: clamp(500px, 68vh, 720px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.35rem, 4vw, 3rem);
    background:
      linear-gradient(rgba(13, 16, 23, 0.2), rgba(13, 16, 23, 0.92)),
      url('/images/generated/ag-platform-architecture.webp') center / cover;
    box-shadow: var(--shadow);
  }

  .case-hero h1 {
    max-width: 14ch;
    margin: 0.7rem 0 1rem;
    font-size: clamp(2.4rem, 5.6vw, 5rem);
    line-height: 0.95;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .case-hero p {
    max-width: 72ch;
    color: color-mix(in srgb, var(--text) 84%, var(--muted) 16%);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
  }

  .case-summary {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  dl {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
  }

  dl div {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  dt {
    color: var(--accent-warm);
    font-weight: 800;
  }

  dd {
    margin: 0.3rem 0 0;
    color: var(--muted);
  }

  .section {
    margin-top: clamp(2.2rem, 5vw, 4rem);
  }

  .architecture {
    border-block: 1px solid var(--border);
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .architecture-card {
    min-height: 230px;
  }

  .architecture-card h3,
  .role-grid h3,
  .tech-grid h3 {
    margin: 0 0 0.75rem;
  }

  .architecture-card p,
  .role-grid p,
  .tech-grid p {
    color: var(--muted);
  }

  .role-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .outcome-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcome-list li {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1rem;
    color: var(--muted);
  }

  .case-film__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .case-film__frame {
    /* square film; fits on one screen below the sticky header (--anchor-offset is at least its height) */
    width: 100%;
    max-width: calc(100svh - var(--anchor-offset));
    margin: 0 auto;
    padding: 0;
    overflow: hidden;

    video {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      background: var(--bg);
    }
  }

  .case-film__text {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-film__text li {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
  }

  .case-film__text strong {
    color: var(--accent-warm);
  }

  .case-film__text p {
    margin: 0.3rem 0 0;
    color: var(--muted);
  }

  .case-film__text .case-film__mine {
    color: var(--text);
    font-weight: 700;
  }

  .case-film__mine::before {
    content: '✓ ' / '';
    color: var(--accent-soft);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .tech-grid .tools {
    color: var(--accent-soft);
    font-size: 0.9rem;
  }

  @media (max-width: 980px) {
    .case-hero,
    .architecture-grid,
    .role-grid,
    .tech-grid {
      grid-template-columns: 1fr 1fr;
    }

    .case-hero > div,
    .case-summary {
      grid-column: 1 / -1;
    }

    .case-film__grid,
    .outcome-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .case-hero,
    .architecture-grid,
    .role-grid,
    .tech-grid {
      grid-template-columns: 1fr;
    }

    /* Sized so "Recommendation" fits one line on 360px+ phones without hyphenation. */
    .case-hero h1 {
      max-width: none;
      font-size: clamp(1.9rem, 9.4vw, 3.2rem);
    }
  }
</style>
